# ====================================================================
# DIGITECA - CONFIGURACIÓN DE ENTORNO Y BASE DE DATOS COCKROACHDB
# ====================================================================

PORT=3000

# OPCIÓN 1: Local
DATABASE_URL=postgresql://root@localhost:26257/digiteca?sslmode=disable

# OPCIÓN 2: CockroachDB Cloud
# DATABASE_URL=postgresql://usuario:password@host.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# Secreto para firma de tokens de sesión (mínimo 16 caracteres)
AUTH_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
